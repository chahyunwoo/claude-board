#!/bin/bash
#
# claude-board 실행 래퍼. ~/.local/bin/claude-board 로 심볼릭 링크해서 쓴다.
#
#   claude-board          띄운다 (이미 떠 있으면 알려주고 끝)
#   claude-board restart  다시 띄운다 (jar 를 새로 빌드한 뒤 쓴다)
#   claude-board stop     내린다
#   claude-board status   상태
#   claude-board log      로그 따라가기
#
# JDK 21 은 keg-only 라 PATH 에 없을 수 있다 (docs/06-개발환경.md).
set -euo pipefail

# ⚠️ GUI 앱(메뉴바 앱)이 이 스크립트를 부를 때는 **PATH 가 비어 있다.**
# lsof·java 를 이름으로만 찾으면 못 찾아 "기동 실패" 로 오판한다 —
# 실측으로 밟았다: 백엔드는 실제로 떴는데 스크립트가 실패를 냈다.
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:${PATH:-}"

ROOT="${CLAUDE_BOARD_ROOT:-$HOME/Documents/projects/hyunwoo/claude-board}"
JAR="$ROOT/build/libs/claude-board.jar"
JAVA="/opt/homebrew/opt/openjdk@21/bin/java"
PORT=7777
LOG_DIR="$HOME/Library/Logs/claude-board"
LOG="$LOG_DIR/claude-board.log"

# ⭐ 기동은 **launchd 가 단독으로** 소유한다.
# 예전에는 이 스크립트가 `nohup java &` 로 자기 프로세스를 띄워 launchd 를 우회했고,
# 그 결과 "launchd 잡은 죽었는데(143) 고아 프로세스가 서비스 중"인 상태가 6일 넘게
# 유지됐다(2026-09-06 실측: launchd state=not running, 실제로는 pid 57955 가 :7777 점유).
# 자동화의 소유자가 둘이면 어느 쪽도 상태를 책임지지 않는다.
SVC="gui/$(id -u)/local.claude-board"
PLIST="$HOME/Library/LaunchAgents/local.claude-board.plist"

# 🔴 실제로 도는 것은 저장소의 jar 이 아니라 이 **사본**이다.
# launchd 로 뜬 java 는 ~/Documents 를 못 읽는다(TCC). 거부(EPERM)가 아니라
# **멈춤**으로 나타나 로그도 포트도 안 나온다 — JVM 런처가 jar 매니페스트를 여는
# open() 에서 무한 대기한다(2026-09-06 실측, 이슈 #46).
# ⚠️ /bin/bash 로 감싸도 소용없다 — TCC 는 실행 파일 단위라 상속되지 않는다.
# 빌드했으면 restart 로 다시 복사해야 반영된다.
RUNTIME_JAR="$HOME/Library/Application Support/claude-board/claude-board.jar"

[ -x "$JAVA" ] || JAVA="$(command -v java || true)"
[ -n "$JAVA" ] || { echo "✗ JDK 21 을 찾지 못했다 — brew install openjdk@21" >&2; exit 1; }

# 포트로 센다. 프로세스 이름은 'java' 라 grep 으로 못 가른다 (docs/05-검증.md 4번).
#
# ⚠️ `|| true` 가 필요하다. lsof 는 매치가 없으면 exit 1 을 내고,
# set -e 가 그것으로 스크립트를 죽인다 — 서버가 안 떠 있을 때 status 조차 못 쓰게 된다.
# 실측으로 밟았다.
running_pid() { /usr/sbin/lsof -nP -iTCP:"$PORT" -sTCP:LISTEN -t 2>/dev/null | head -1 || true; }

case "${1:-start}" in
  start)
    pid="$(running_pid)"
    if [ -n "$pid" ]; then
      echo "이미 떠 있다 (pid $pid) — http://127.0.0.1:$PORT"
      exit 0
    fi
    [ -f "$JAR" ] || { echo "✗ jar 이 없다 — scripts/build.sh 를 먼저 돌려라" >&2; exit 1; }
    # 런타임 사본이 없으면 launchd 가 열 것이 없다. 설치 스크립트가 만든다.
    [ -f "$RUNTIME_JAR" ] || { echo "✗ 런타임 jar 이 없다 — scripts/install-agent.sh 를 돌려라" >&2; exit 1; }
    mkdir -p "$LOG_DIR"
    # ⚠️ bootstrap 만으로는 시작되지 않는 경우가 있다 — RunAtLoad 가 true 인데
    #    runs = 0 으로 남는다 (docs/04-배포.md 실측, 전역 launchd 표준 §5).
    #    "등록했다"와 "돌고 있다"는 다르다.
    #
    #    🔴 `bootstrap || kickstart` 로 쓰면 안 된다. bootstrap 이 **성공하면**
    #       kickstart 를 안 타는데, 정작 runs = 0 인 경우가 바로 그 성공 경로다.
    #       (실측 2026-09-06: bootout 으로 완전히 빠진 뒤 start 하면 bootstrap 이
    #        성공하면서 runs = 0 으로 남아 기동 실패로 끝났다. 반대로 이미 등록된
    #        상태에서는 bootstrap 이 실패해 kickstart 가 타므로 증상이 안 보인다 —
    #        그래서 stop→start 왕복 검증만으로는 이 버그가 드러나지 않는다.)
    #    → 등록과 기동을 **따로** 한다. kickstart 는 이미 돌고 있으면 무해하다.
    launchctl bootstrap "gui/$(id -u)" "$PLIST" 2>/dev/null || true
    # ⚠️ bootout 직후엔 잡이 아직 빠지는 중이라 bootstrap 이 **조용히 실패**한다.
    #    등록 여부를 확인하고, 아니면 한 번 더 시도한다 — 미등록 상태로 kickstart 를
    #    부르면 아무 일도 안 일어나고 "기동 실패"로만 끝난다(2026-09-06 실측).
    if ! launchctl print "$SVC" >/dev/null 2>&1; then
      sleep 2
      launchctl bootstrap "gui/$(id -u)" "$PLIST" \
        || { echo "✗ launchd 등록 실패 — launchctl bootstrap 오류를 확인해라" >&2; exit 1; }
    fi
    launchctl kickstart "$SVC" >/dev/null 2>&1 || true
    for _ in $(seq 1 15); do pid="$(running_pid)"; [ -n "$pid" ] && break; sleep 1; done
    [ -n "$pid" ] || { echo "✗ 기동 실패 — $LOG 를 봐라" >&2; tail -5 "$LOG" >&2; exit 1; }
    echo "✓ 떴다 (pid $pid) — http://127.0.0.1:$PORT"
    ;;
  stop)
    pid="$(running_pid)"
    # bootout 해야 멈춘다. kill 만 하면 KeepAlive 가 즉시 다시 띄운다.
    launchctl bootout "$SVC" 2>/dev/null || true
    # bootout 은 비동기다. 완전히 빠질 때까지 기다린다 —
    # 안 기다리면 곧바로 오는 start 의 bootstrap 이 실패한다.
    for _ in $(seq 1 10); do launchctl print "$SVC" >/dev/null 2>&1 || break; sleep 1; done
    [ -n "$pid" ] && echo "✓ 내렸다 (pid $pid)" || echo "떠 있지 않다"
    ;;
  restart)
    "$0" stop
    sleep 2
    # ⚠️ 런타임 jar 은 사본이라 빌드해도 자동으로 안 바뀐다. 여기서 다시 복사한다 —
    #    빠뜨리면 "빌드했는데 안 바뀐다" 가 되고, 원인이 안 보인다.
    if [ -f "$JAR" ]; then
      mkdir -p "$(dirname "$RUNTIME_JAR")"
      cp "$JAR" "$RUNTIME_JAR" && echo "✓ jar 갱신 ($(date -r "$JAR" '+%m-%d %H:%M'))"
    fi
    "$0" start
    ;;
  status)
    pid="$(running_pid)"
    if [ -n "$pid" ]; then
      echo "떠 있다 (pid $pid)"
      # 바인딩이 127.0.0.1 인지 함께 보인다 — 이 도구의 절대 원칙이다
      lsof -nP -iTCP:"$PORT" -sTCP:LISTEN | tail -n +2
      echo "저장소 jar: $(date -r "$JAR" '+%Y-%m-%d %H:%M')"
      echo "런타임 jar: $(date -r "$RUNTIME_JAR" '+%Y-%m-%d %H:%M')  ← 실제로 도는 것"
      # 사본이라 어긋날 수 있다. 조용히 옛 jar 이 도는 것을 막는다.
      [ "$JAR" -nt "$RUNTIME_JAR" ] && echo "⚠️ 저장소 jar 이 더 최근이다 — claude-board restart 로 반영한다"
    else
      echo "떠 있지 않다"
    fi
    ;;
  log)  tail -f "$LOG" ;;
  *)    echo "usage: claude-board [start|stop|restart|status|log]" >&2; exit 1 ;;
esac
