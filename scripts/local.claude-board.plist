<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.claude-board</string>

  <!-- ⚠️ `__JAR__`·`__LOG__`·`__ROOT__`·`__PATH__` 는 install-agent.sh 가 치환한다.
       🔴 경로를 하드코딩하지 않는다 — 저장소 위치가 기계마다 다르다.

       표준 형태: 런타임 절대경로 + 대상. launchd 는 PATH 를 물려주지 않고,
       JDK 21 은 keg-only 라 /usr/bin/java 로는 안 잡힌다 (docs/06-개발환경.md). -->
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/opt/openjdk@21/bin/java</string>
    <string>-jar</string>
    <string>__JAR__</string>
  </array>

  <!-- ⚠️ launchd 는 PATH 를 물려주지 않는다. claude CLI 를 못 찾으면
       세션 목록이 비어 화면이 텅 빈다 — 실측으로 밟았고, errors 가 알려줬다:
         "agents 목록을 읽지 못함: Cannot run program \"claude\"" -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
  </dict>

  <key>RunAtLoad</key><true/>

  <!-- ⭐ KeepAlive 는 **작동한다.** 옛 주석("이 환경에서 작동하지 않는다,
       143 을 정상 종료로 본다")은 오진이었다 — 2026-09-06 재조사:
         · 셸 래퍼가 `nohup java &` 로 자기 프로세스를 띄워 launchd 를 우회했고,
         · `claude-board stop` 이 포트로 찾아 죽인 대상이 launchd 가 띄운 java 였다.
           그래서 143(SIGTERM)이 찍혔고, KeepAlive 가 없으니 그대로 방치됐다.
         · 그 뒤 래퍼가 띄운 고아 프로세스가 서비스해서 "launchd 는 죽었는데
           화면은 뜬다"는 상태가 유지됐다(실측: state=not running, pid 57955 가 :7777).
       이제 래퍼가 launchctl 로 위임하므로 우회 경로가 없다.
       SuccessfulExit 을 쓰지 않고 무조건 재시작한다 — 조회 전용 대시보드라
       어떤 이유로 죽든 다시 떠 있는 것이 맞다. -->
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>

  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>

  <!-- 데이터는 이 기계를 떠나지 않는다. 세션 기록을 읽으려면 홈이 필요하다. -->
  <key>WorkingDirectory</key><string>__ROOT__</string>
</dict>
</plist>
