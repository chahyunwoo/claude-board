#!/bin/sh
# 되돌리기 검증(뮤테이션) 잔재가 커밋에 섞이는 것을 막는다.
#
# 텍스트 지시로는 다음 세션에 조용히 스킵된다 — 훅으로 강제한다.
# 패턴은 어간으로 잡는다: MUTATION·MUTATED·MUTANT 를 모두 걸리게 해야 한다
# (MUTANT|MUTATED 만 쓰면 MUTATION 을 놓친다).
#
# 설치: git config core.hooksPath .githooks
#
# ⚠️ 파일 목록은 **반드시 -z(NUL 구분)로** 받는다.
#    `--name-only` 만 쓰면 git 이 ASCII 밖의 경로를 따옴표로 감싸고 이스케이프한다
#    (`"docs/\355\224\204\353\241\240\355\212\270.md"`). 그 문자열을 경로로 넘기면
#    그런 파일이 없어서 git grep 이 **아무것도 검사하지 못하고 조용히 통과**한다.
#
#    실측(#13): 이 저장소의 문서는 전부 한글 파일명이라, 훅이 있는 채로
#    문서에 잔재를 넣어도 **전부 통과했다**. 영문 파일명만 잡히고 있었다.
#    게이트가 있다 ≠ 게이트가 작동한다 — 아래 "훅 자체를 검사하는 법" 참고.

# 검사 대상은 **코드**다. 둘을 제외한다:
#   - 훅 자신 — 패턴 문자열을 담고 있어 스스로 걸린다.
#   - docs/    — 문서는 이 패턴을 *설명하려고 인용*해야 한다(06-개발환경.md 가 그렇다).
#                제외하지 않으면 훅을 설명하는 문서가 훅에 막혀 영영 커밋되지 않는다.
#                뮤테이션 잔재는 소스에 남는 문제이므로 검사 가치도 코드 쪽에 있다.
files=$(git diff --cached --name-only -z --diff-filter=ACM |
        tr '\0' '\n' |
        grep -v '^\.githooks/pre-commit$' |
        grep -v '^docs/')
[ -z "$files" ] && exit 0

# 경로에 공백이 있어도 안전하게 넘기려고 stdin 으로 준다.
hits=$(printf '%s\n' "$files" |
       tr '\n' '\0' |
       xargs -0 git grep --cached -n -E 'MUTAT|MUTANT' -- 2>/dev/null)

if [ -n "$hits" ]; then
    echo "커밋 거부 — 뮤테이션 잔재가 남아 있습니다:"
    echo "$hits"
    echo ""
    echo "되돌리기 검증에 쓴 임시 변경을 복구한 뒤 다시 커밋하세요."
    echo "(git checkout 말고 백업 파일 복사로 복구할 것 — 같은 파일의 다른 수정이 날아갑니다)"
    exit 1
fi

exit 0
